{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmach-karov",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gmach-karov-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ITEM_IMAGES",
      "bucket_name": "gmach-karov-images"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "RESEND_FROM_EMAIL": "Gmach Berega <onboarding@resend.dev>",
    "SUPPORT_EMAIL": "netanelhirsh@gmail.com"
  }
}
